    {
      "name": "Users",
      "item": [
        {
          "name": "Find all users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users?page=0&size=20",
              "host": ["{{baseUrl}}"], "path": ["api", "v1", "users"],
              "query": [
                { "key": "role", "value": "", "disabled": true },
                { "key": "status", "value": "", "disabled": true },
                { "key": "email", "value": "", "disabled": true },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Find user by id",
